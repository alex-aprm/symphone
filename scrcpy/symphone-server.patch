+
+    /** PhoneSync patch: SurfaceControl.createDisplay moved here in Android 14+ (signature varies by release). */
+    public static IBinder createVirtualDisplay(String name, boolean secure) throws ReflectiveOperationException {
+        if (CLASS == null) {
+            throw new ClassNotFoundException("DisplayControl unavailable");
+        }
+        for (Method m : CLASS.getDeclaredMethods()) {
+            if (!m.getName().equals("createVirtualDisplay") && !m.getName().equals("createDisplay")) {
+                continue;
+            }
+            Class<?>[] p = m.getParameterTypes();
+            Object[] args = new Object[p.length];
+            for (int i = 0; i < p.length; i++) {
+                if (p[i] == String.class) {
+                    args[i] = i == 0 ? name : name + "-" + System.nanoTime();
+                } else if (p[i] == boolean.class) {
+                    args[i] = secure;
+                } else if (p[i] == float.class) {
+                    args[i] = 0f;
+                } else {
+                    args[i] = null;
+                }
+            }
+            m.setAccessible(true);
+            Ln.i("DisplayControl." + m.getName() + " with " + p.length + " args");
+            return (IBinder) m.invoke(null, args);
+        }
+        throw new NoSuchMethodException("DisplayControl.createVirtualDisplay");
+    }
+
+    public static void destroyVirtualDisplay(IBinder token) {
+        if (CLASS == null) {
+            return;
+        }
+        for (Method m : CLASS.getDeclaredMethods()) {
+            if ((m.getName().equals("destroyVirtualDisplay") || m.getName().equals("destroyDisplay")) && m.getParameterTypes().length == 1) {
+                try {
+                    m.setAccessible(true);
+                    m.invoke(null, token);
+                } catch (ReflectiveOperationException e) {
+                    Ln.w("Could not destroy display: " + e);
+                }
+                return;
+            }
+        }
+    }
 }
