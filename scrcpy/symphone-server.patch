@@ -0,0 +1,170 @@
+package com.genymobile.scrcpy.video;
+
+import com.genymobile.scrcpy.util.Ln;
+
+import android.content.ComponentName;
+import android.os.IBinder;
+import android.os.SystemClock;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.List;
+
+/**
+ * PhoneSync patch: tells whether a virtual display currently shows real app content, or only its home/launcher (or
+ * nothing). Polls the root tasks of the display through IActivityTaskManager; while "hidden" the capture must not
+ * deliver frames, so the PC keeps (and blurs) the last app frame instead of showing the launcher.
+ */
+public final class ContentGate {
+
+    public interface Listener {
+        /** Called on the gate thread on every state change (and once with the initial state). */
+        void onChanged(boolean shown, String pkg);
+    }
+
+    private static final int ACTIVITY_TYPE_HOME = 2;
+    private static final int ACTIVITY_TYPE_RECENTS = 3;
+    private static final long POLL_MS = 30;
+
+    private final int displayId;
+    private final Listener listener;
+    private volatile boolean shown;
+    private volatile String pkg = "";
+    private volatile boolean running;
+    private Thread thread;
+
+    private Object atm;
+    private Method getRootTasksOnDisplay;
+    private boolean broken;
+
+    public ContentGate(int displayId, Listener listener) {
+        this.displayId = displayId;
+        this.listener = listener;
+    }
+
+    public boolean isShown() {
+        return shown;
+    }
+
+    public String getPackage() {
+        return pkg;
+    }
+
+    private void prepare() throws ReflectiveOperationException {
+        Class<?> smClass = Class.forName("android.os.ServiceManager");
+        IBinder binder = (IBinder) smClass.getDeclaredMethod("getService", String.class).invoke(null, "activity_task");
+        atm = Class.forName("android.app.IActivityTaskManager$Stub").getMethod("asInterface", IBinder.class).invoke(null, binder);
+        getRootTasksOnDisplay = atm.getClass().getMethod("getAllRootTaskInfosOnDisplay", int.class);
+    }
+
+    private static Object field(Object o, String name) {
+        for (Class<?> c = o.getClass(); c != null; c = c.getSuperclass()) {
+            try {
+                Field f = c.getDeclaredField(name);
+                f.setAccessible(true);
+                return f.get(o);
+            } catch (NoSuchFieldException e) {
+                // try the superclass
+            } catch (IllegalAccessException e) {
+                return null;
+            }
+        }
+        return null;
+    }
+
+    private static boolean isLauncher(String p) {
+        String l = p.toLowerCase();
+        return l.contains("launcher") || l.equals("com.android.systemui");
+    }
+
+    /** Evaluates the display now. Returns null if the state can't be determined (keeps the previous state). */
+    private Object[] evaluate() {
+        try {
+            List<?> tasks = (List<?>) getRootTasksOnDisplay.invoke(atm, displayId);
+            if (tasks != null) {
+                // Root tasks come in z-order, top first: the topmost visible one decides.
+                for (Object t : tasks) {
+                    Object visible = field(t, "visible");
+                    if (visible == null) {
+                        visible = field(t, "isVisible");
+                    }
+                    if (Boolean.FALSE.equals(visible)) {
+                        continue;
+                    }
+                    Object type = field(t, "topActivityType");
+                    ComponentName top = (ComponentName) field(t, "topActivity");
+                    if (top == null) {
+                        top = (ComponentName) field(t, "baseActivity");
+                    }
+                    String p = top != null ? top.getPackageName() : "";
+                    boolean home = type instanceof Integer && ((Integer) type == ACTIVITY_TYPE_HOME || (Integer) type == ACTIVITY_TYPE_RECENTS);
+                    return new Object[] {!home && !p.isEmpty() && !isLauncher(p), p};
+                }
+            }
+            return new Object[] {false, ""};
+        } catch (Throwable e) {
+            if (!broken) {
+                broken = true;
+                Ln.w("Content gate: cannot read tasks of display " + displayId + ": " + e);
+            }
+            return null;
+        }
+    }
+
+    /** Synchronously computes the initial state, then polls on a background thread. */
+    public void start() {
+        try {
+            prepare();
+        } catch (ReflectiveOperationException e) {
+            Ln.w("Content gate unavailable (always shown): " + e);
+            shown = true;
+            listener.onChanged(true, "");
+            return;
+        }
+        Object[] r = evaluate();
+        shown = r == null || (Boolean) r[0];
+        pkg = r == null ? "" : (String) r[1];
+        Ln.i("Content gate on display " + displayId + ": " + (shown ? "shown " : "hidden ") + pkg);
+        listener.onChanged(shown, pkg);
+        running = true;
+        thread = new Thread(this::loop, "content-gate");
+        thread.setDaemon(true);
+        thread.start();
+    }
+
+    /** Re-evaluates immediately (cheap); used by capture loops right after grabbing a frame. */
+    public boolean checkNow() {
+        Object[] r = evaluate();
+        if (r != null) {
+            update((Boolean) r[0], (String) r[1]);
+        }
+        return shown;
+    }
+
+    private synchronized void update(boolean s, String p) {
+        if (s != shown || (s && !p.equals(pkg))) {
+            shown = s;
+            pkg = p;
+            Ln.i("Content gate on display " + displayId + ": " + (s ? "shown " : "hidden ") + p);
+            listener.onChanged(s, p);
+        }
+    }
+
+    private void loop() {
+        while (running) {
+            Object[] r = evaluate();
+            if (r != null) {
+                update((Boolean) r[0], (String) r[1]);
+            }
+            SystemClock.sleep(POLL_MS);
+        }
+    }
+
+    public void stop() {
+        running = false;
+        if (thread != null) {
+            thread.interrupt();
+            thread = null;
+        }
+    }
+}
