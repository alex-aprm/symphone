+ * PhoneSync patch: mirrors the main display by taking GPU screenshots (the path used by `screencap`) and drawing them
+ * into the encoder surface. Used on ROMs that block mirror virtual displays for the shell (e.g. nubia "NDMCtrl").
+ * Screenshots are HardwareBuffer-backed, so each frame stays on the GPU.
+ */
+public final class ScreenshotStreamer {
+
+    private final Surface surface;
+    private final int width;
+    private final int height;
+    private final int fps;
+    private volatile boolean running;
+    private Thread thread;
+
+    private Method captureMethod;
+    private Object captureArgs;
+
+    // Capture by display id (virtual displays) through IWindowManager.captureDisplay
+    private final int displayId;
+    private final ContentGate gate; // PhoneSync: no frames while the display shows only its home (may be null)
+    private Object windowManager;
+    private Method wmCaptureMethod;
+    private Method createSyncListenerMethod;
+
+    public ScreenshotStreamer(Surface surface, int width, int height, int fps) {
+        this(surface, width, height, fps, -1, null);
+    }
+
+    public ScreenshotStreamer(Surface surface, int width, int height, int fps, int displayId, ContentGate gate) {
+        this.surface = surface;
+        this.width = width;
+        this.height = height;
+        this.fps = fps > 0 ? fps : 60;
+        this.displayId = displayId;
+        this.gate = gate;
+    }
+
+    private void prepareCaptureById() throws ReflectiveOperationException {
+        Class<?> smClass = Class.forName("android.os.ServiceManager");
+        IBinder binder = (IBinder) smClass.getDeclaredMethod("getService", String.class).invoke(null, "window");
+        Class<?> stub = Class.forName("android.view.IWindowManager$Stub");
+        windowManager = stub.getMethod("asInterface", IBinder.class).invoke(null, binder);
+        for (Method m : windowManager.getClass().getMethods()) {
+            if (m.getName().equals("captureDisplay") && m.getParameterTypes().length == 3) {
+                wmCaptureMethod = m;
+            }
+        }
+        if (wmCaptureMethod == null) {
+            throw new NoSuchMethodException("IWindowManager.captureDisplay");
+        }
+        createSyncListenerMethod = Class.forName("android.window.ScreenCapture").getMethod("createSyncCaptureListener");
+    }
+
+    private Object captureById() throws ReflectiveOperationException {
+        Object listener = createSyncListenerMethod.invoke(null);
+        wmCaptureMethod.invoke(windowManager, displayId, null, listener);
+        return listener.getClass().getMethod("getBuffer").invoke(listener);
+    }
+
+    public static IBinder mainDisplayToken() {
+        try {
+            long[] ids = DisplayControl.getPhysicalDisplayIds();
+            if (ids != null && ids.length > 0) {
+                IBinder token = DisplayControl.getPhysicalDisplayToken(ids[0]);
+                if (token != null) {
+                    return token;
+                }
+            }
+        } catch (Throwable e) {
+            Ln.w("DisplayControl token: " + e);
+        }
+        return SurfaceControl.getBuiltInDisplay();
+    }
+
+    private void prepareCapture(IBinder token) throws ReflectiveOperationException {
+        Class<?> sc = Class.forName("android.window.ScreenCapture");
+        Class<?> argsClass = Class.forName("android.window.ScreenCapture$DisplayCaptureArgs");
+        Class<?> builderClass = Class.forName("android.window.ScreenCapture$DisplayCaptureArgs$Builder");
+        Object builder = builderClass.getConstructor(IBinder.class).newInstance(token);
+        try {
+            builderClass.getMethod("setSize", int.class, int.class).invoke(builder, width, height);
+        } catch (NoSuchMethodException e) {
+            Ln.w("DisplayCaptureArgs.setSize unavailable; capturing at native size");
+        }
+        captureArgs = builderClass.getMethod("build").invoke(builder);
+        captureMethod = sc.getMethod("captureDisplay", argsClass);
+    }
+
+    public void start() throws ReflectiveOperationException {
+        if (displayId >= 0) {
+            prepareCaptureById();
+        } else {
+            IBinder token = mainDisplayToken();
+            if (token == null) {
+                throw new ReflectiveOperationException("no display token");
+            }
+            prepareCapture(token);
+        }
+        running = true;
+        thread = new Thread(this::loop, "screenshot-capture");
+        thread.start();
+        Ln.i("Display: using screenshot capture " + width + "x" + height + " @" + fps + "fps");
+    }
+
+    private void loop() {
+        Paint paint = new Paint(Paint.FILTER_BITMAP_FLAG);
+        Rect dst = new Rect(0, 0, width, height);
+        long frameNs = 1_000_000_000L / fps;
+        int failures = 0;
+        while (running) {
+            long t0 = SystemClock.elapsedRealtimeNanos();
+            if (gate != null && !gate.isShown()) {
+                SystemClock.sleep(10);
+                continue;
+            }
+            try {
+                Object shot = displayId >= 0 ? captureById() : captureMethod.invoke(null, captureArgs);
+                if (shot == null) {
+                    throw new IllegalStateException("null screenshot");
+                }
+                HardwareBuffer hb = (HardwareBuffer) shot.getClass().getMethod("getHardwareBuffer").invoke(shot);
+                Bitmap bmp = (Bitmap) shot.getClass().getMethod("asBitmap").invoke(shot);
+                if (!running) {
+                    hb.close();
+                    break;
+                }
+                if (gate != null && !gate.checkNow()) {
+                    // the content changed to the launcher while this frame was taken: never deliver it
+                    hb.close();
+                    continue;
+                }
+                Canvas canvas = surface.lockHardwareCanvas();
+                try {
+                    canvas.drawBitmap(bmp, null, dst, paint);
+                } finally {
+                    surface.unlockCanvasAndPost(canvas);
+                }
+                hb.close();
+                failures = 0;
+            } catch (Throwable e) {
+                if (!running) {
+                    break;
+                }
+                if (++failures == 1 || failures % 100 == 0) {
+                    Ln.w("Screenshot capture failed (" + failures + "): " + e);
+                }
+                SystemClock.sleep(50);
+            }
+            long sleepNs = frameNs - (SystemClock.elapsedRealtimeNanos() - t0);
+            if (sleepNs > 0) {
+                SystemClock.sleep(sleepNs / 1_000_000L);
+            }
+        }
+    }
+
+    public void stop() {
+        running = false;
+        if (thread != null) {
+            try {
+                thread.join(500);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            }
+            thread = null;
+        }
+    }
+}
